# Binder resolver APK — built from Resolver/, NOT committed. It gets embedded
# into the binary with include_bytes! (src/daemon/codes.rs), so copy the gradle
# output here before building locally:
#   cd Resolver && ./gradlew assembleRelease
#   cp app/build/outputs/apk/release/app-release-unsigned.apk ../Cargo/binder_resolver.apk
# CI stages it automatically before `cargo ndk build`.
Cargo/binder_resolver.apk
